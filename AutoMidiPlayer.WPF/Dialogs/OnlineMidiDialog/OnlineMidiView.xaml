<UserControl x:Class="AutoMidiPlayer.WPF.Dialogs.OnlineMidiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:AutoMidiPlayer.WPF.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Width="480"
                Background="Transparent"
                Margin="0,0,12,0"
                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

        <!-- Source picker -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Source"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Sources}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"/>
        </Grid>

        <!-- Console picker (only for browse-based sources like VGMusic) -->
        <Grid Margin="0,0,0,8"
              Visibility="{Binding HasCategories, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Console"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Categories}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
        </Grid>

        <!-- Search box -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        x:Name="SearchBox"
                        PlaceholderText="Search for a song title..."
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="Search12"
                        KeyDown="OnSearchBoxKeyDown"
                        VerticalAlignment="Center"/>

            <controls:Button Grid.Column="1"
                             Margin="6,0,0,0"
                             Variant="Filled"
                             Content="Search"
                             IsEnabled="{Binding CanSearch}"
                             Click="OnSearchClick"/>
        </Grid>

        <!-- Status / message line -->
        <Grid Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="18"
                                 Height="18"/>
                <TextBlock Text="Searching..."
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- Results -->
        <Border Margin="0,10,0,0"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer MaxHeight="320"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8,10,8"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Add button -->
                                    <controls:Button Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     Variant="Outlined"
                                                     Content="{Binding ActionText}"
                                                     IsEnabled="{Binding CanAdd}"
                                                     Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     Click="OnAddClick"/>

                                    <ui:ProgressRing Grid.Column="1"
                                                     IsIndeterminate="True"
                                                     Width="20"
                                                     Height="20"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Load more -->
        <controls:Button Margin="0,10,0,0"
                         HorizontalAlignment="Center"
                         Variant="Ghost"
                         Content="Load more results"
                         IsEnabled="{Binding CanLoadMore}"
                         Visibility="{Binding HasMorePages, Converter={StaticResource BoolToVisibilityConverter}}"
                         Click="OnLoadMoreClick"/>
    </StackPanel>
</UserControl>
