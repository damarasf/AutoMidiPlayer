<UserControl
    x:Class="AutoMidiPlayer.WPF.Views.MidiShowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:controls="clr-namespace:AutoMidiPlayer.WPF.Controls"
    xmlns:viewModels="clr-namespace:AutoMidiPlayer.WPF.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:MidiShowViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:SimpleStackPanel Grid.Column="0"
                                       Orientation="Horizontal"
                                       Spacing="4"
                                       VerticalAlignment="Center">
                <controls:Button Variant="Ghost"
                                 Padding="8"
                                 ToolTip="Back"
                                 Click="OnBack">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
                </controls:Button>
                <controls:Button Variant="Ghost"
                                 Padding="8"
                                 ToolTip="Forward"
                                 Click="OnForward">
                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16"/>
                </controls:Button>
                <controls:Button Variant="Ghost"
                                 Padding="8"
                                 ToolTip="Reload"
                                 Click="OnReload">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16"/>
                </controls:Button>
                <controls:Button Variant="Ghost"
                                 Padding="8"
                                 ToolTip="MidiShow home"
                                 Click="OnHome">
                    <ui:SymbolIcon Symbol="Home24" FontSize="16"/>
                </controls:Button>
            </controls:SimpleStackPanel>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding StatusMessage}"/>
        </Grid>

        <!-- Embedded MidiShow site -->
        <Border Grid.Row="1"
                CornerRadius="6"
                ClipToBounds="True"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <wv2:WebView2 x:Name="Browser"/>
        </Border>
    </Grid>
</UserControl>
