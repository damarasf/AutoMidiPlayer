<UserControl
    x:Class="AutoMidiPlayer.WPF.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:controls="clr-namespace:AutoMidiPlayer.WPF.Controls"
    xmlns:helpers="clr-namespace:AutoMidiPlayer.WPF.Helpers"
    xmlns:viewModels="clr-namespace:AutoMidiPlayer.WPF.ViewModels"
    xmlns:properties="clr-namespace:AutoMidiPlayer.Data.Properties;assembly=AutoMidiPlayer.Data"
    d:DataContext="{d:DesignInstance Type=viewModels:AboutViewModel}">
    <UserControl.Resources>
        <properties:Settings x:Key="Settings"/>

        <ControlTemplate x:Key="ContributorButtonTemplate" TargetType="Button">
            <Border CornerRadius="20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="16"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <ui:SymbolIcon Symbol="Person24"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Image Source="{Binding AvatarPath, TargetNullValue={x:Null}}"
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry RadiusX="16"
                                                     RadiusY="16"
                                                     Center="16,16"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <Grid x:Name="NameGrid" MaxWidth="0" Opacity="0">
                        <TextBlock Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,12,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <StopStoryboard BeginStoryboardName="ExitStoryboard"/>
                        <BeginStoryboard Name="EnterStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="NameGrid"
                                                 Storyboard.TargetProperty="MaxWidth"
                                                 To="120"
                                                 Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="NameGrid"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard Name="ExitStoryboard">
                            <Storyboard BeginTime="0:0:0.1">
                                <DoubleAnimation Storyboard.TargetName="NameGrid"
                                                 Storyboard.TargetProperty="MaxWidth"
                                                 To="0"
                                                 Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="NameGrid"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="AnimatedCardButtonStyle"
               TargetType="Button">
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Background"
                    Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="HoverBorder"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Opacity="0"/>
                            <Border x:Name="PressedBorder"
                                    Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.09">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressedBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AboutActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AnimatedCardButtonStyle}">
            <Setter Property="Padding"
                    Value="12,6"/>
            <Setter Property="Margin"
                    Value="0,0,12,12"/>
            <Setter Property="MinWidth"
                    Value="180"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="LicenseChipButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AnimatedCardButtonStyle}">
            <Setter Property="Padding"
                    Value="16,12"/>
            <Setter Property="Margin"
                    Value="0,0,12,12"/>
            <Setter Property="MinWidth"
                    Value="220"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>
    </UserControl.Resources>

    <controls:SimpleStackPanel Spacing="16">
            <controls:Section Title="Links">
                <controls:SimpleStackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AboutActionButtonStyle}"
                                        Command="{s:Action OpenUrl}"
                                        CommandParameter="{Binding Url}">
                                    <Button.ToolTip>
                                        <TextBlock Text="{Binding Tooltip}"
                                                   FontSize="10"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="380"/>
                                    </Button.ToolTip>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol, Mode=OneWay}" Margin="0,0,8,0" FontSize="16" />
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:SimpleStackPanel>
            </controls:Section>

            <controls:Section Title="Special Thanks">
                <controls:SimpleStackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="12">
                        This project was originally forked from <InlineUIContainer BaselineAlignment="Center"><controls:Hyperlink NavigateUri="https://github.com/sabihoshi/GenshinLyreMidiPlayer" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" MinHeight="0"><TextBlock Text="sabihoshi/GenshinLyreMidiPlayer" FontSize="12"/></controls:Hyperlink></InlineUIContainer> v4.0.5 and later detached into its own repository to enable multi-game support and features that do not fit the original Genshin Impact-only design. Huge thanks for the original work!
                    </TextBlock>

                    <TextBlock Text="Contributors"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>

                    <ItemsControl ItemsSource="{Binding Contributors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{s:Action OpenUrl}"
                                        CommandParameter="{Binding ProfileUrl}"
                                        Padding="0"
                                        Margin="0,0,8,8"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        Template="{StaticResource ContributorButtonTemplate}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:SimpleStackPanel>
            </controls:Section>

            <controls:Section Title="Open Source Licenses">
                <controls:SimpleStackPanel Spacing="6">

                    <ItemsControl ItemsSource="{Binding ThirdPartyLicenses}"
                                  Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LicenseChipButtonStyle}"
                                        Command="{s:Action ShowThirdPartyLicense}"
                                        CommandParameter="{Binding}">
                                    <controls:SimpleStackPanel Spacing="4">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Version}"
                                                       FontSize="12"
                                                       Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding LicenseName}"
                                                   FontSize="12"
                                                   Opacity="0.7"/>
                                    </controls:SimpleStackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               Opacity="0.7">
                        All rights reserved by © miHoYo Co., Ltd., © XD Inc., © thatgamecompany, Inc., © Roblox Corporation, and © Hotta Studio, a Perfect World company.
                        Not affiliated with miHoYo, XD, thatgamecompany, Roblox, or Hotta Studio.
                    </TextBlock>
                </controls:SimpleStackPanel>
            </controls:Section>
    </controls:SimpleStackPanel>
</UserControl>
